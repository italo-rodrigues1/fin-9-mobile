EXPO_PUBLIC_API_URL=http://localhost:3333

# Client IDs públicos criados no mesmo projeto do Google Cloud (não são Client Secrets).
# O backend deve usar este mesmo valor em GOOGLE_WEB_CLIENT_ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Necessário para o login no iOS. O callback é configurado pelo app.config.ts.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
